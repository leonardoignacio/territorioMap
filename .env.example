# Configuração do Firebase - Copie este arquivo para .env e preencha com suas credenciais

VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_MEASUREMENT_ID" # Opcional

# Caminho base para imagens no Firebase Storage (ex: https://storage.googleapis.com/your-bucket-name/images/)
VITE_FIREBASE_STORAGE_IMAGE_BASE_PATH="YOUR_STORAGE_IMAGE_BASE_PATH"

